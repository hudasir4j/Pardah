# Server
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Face search engines (at least one recommended for production)
FACECHECK_API_TOKEN=
FACECHECK_TESTING_MODE=true
PIMEYES_API_KEY=

# Verification
DEEPFACE_MODEL=Facenet512
CONFIDENCE_THRESHOLD=85

# Session & privacy
SESSION_TTL_MINUTES=30
SESSION_ENCRYPTION_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Optional Supabase (ephemeral session metadata only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional S3 ephemeral storage (falls back to local temp dir)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Scraper
SCRAPER_TIMEOUT_MS=15000
SCRAPER_ENABLED=true
