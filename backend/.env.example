# Optional: SerpApi key for Google Images search.
# Get a key at https://serpapi.com/ . Without this, we still search Bing + DuckDuckGo Images.
# SERPAPI_API_KEY=your_serpapi_key_here

# Per-request work limits. Smaller = faster + less RAM. Tuned for small
# (512 MB - 1 GB) hosts; raise these if you have headroom.
IMAGES_PER_SOURCE=2
MAX_SEARCH_QUERIES=2
MAX_CANDIDATE_IMAGES=6
MAX_MATCHED_IMAGES=5

# How many search providers to query in parallel. Each in-flight job holds
# an HTTP buffer; cap low on small instances.
SEARCH_FANOUT_WORKERS=4

# Face-recognition model used by DeepFace. Defaults to SFace (~37 MB,
# 128-dim embeddings) which fits comfortably under 1 GB RAM. Switch to
# Facenet512 (~95 MB, 512-dim, more accurate) on larger hosts.
# Other options: ArcFace, VGG-Face, OpenFace, GhostFaceNet, Facenet.
FACE_MODEL=SFace

# Cosine-distance threshold for "is this a match" (lower = stricter).
# Leave unset to use a model-aware default (SFace: 0.60, Facenet512: 0.50).
# FACE_MATCH_THRESHOLD=0.6

# Concurrent candidate downloads/decodes during face matching. Each worker
# holds an image buffer in RAM, so keep low on tight hosts.
FACE_MATCH_WORKERS=2

# Max edge (px) any candidate is downscaled to before face detection.
# Lower = less decode RAM, slightly worse small-face detection.
FACE_MAX_IMAGE_EDGE=640

# CORS allow-list. Comma-separated origins, or "*" for any. Set this to
# your deployed frontend in production, e.g.:
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGINS=*
